
(* -------------------------------------------------------------------------- *)
(* Sharing (only in PatMapSharing, whose children are mutable). *)

(* Comparisons that, as a side effect, make equal subtrees of their
   arguments physically equal (see [PatSet.Sharing]). Two subtrees are
   unified when they have the same keys and values related by the equality
   or comparison function, so this function must only relate interchangeable
   values. Two children are unified by [Bit_lib.share_field]. *)
module Sharing = struct
  (* The children are the fields [2] and [3] of a [Node] block. [share a b i]
     unifies the fields [i] of the nodes [a] and [b]. *)
  let field_l = 2
  let field_r = 3
  let[@inline] share (a : 'a t) (b : 'a t) i =
    ignore (Bit_lib.share_field (Obj.repr a) (Obj.repr b) i)

  let rec equal eq a b =
    a == b ||
    match a, b with
    | Node na, Node nb ->
      na.k = nb.k && eq na.v nb.v &&
      (na.l == nb.l || (equal eq na.l nb.l && (share a b field_l; true))) &&
      (na.r == nb.r || (equal eq na.r nb.r && (share a b field_r; true)))
    | _ -> false

  let rec compare cmp a b =
    if a == b then 0 else
    match a, b with
    | Empty, _ -> -1
    | _, Empty -> 1
    | Node na, Node nb ->
      let c = Int.compare na.k nb.k in
      if c <> 0 then c else
      let c = cmp na.v nb.v in
      if c <> 0 then c else
      let c = if na.l == nb.l then 0 else compare cmp na.l nb.l in
      if c <> 0 then c else begin
        if na.l != nb.l then share a b field_l;
        let c = if na.r == nb.r then 0 else compare cmp na.r nb.r in
        if c = 0 && na.r != nb.r then share a b field_r;
        c
      end
end
